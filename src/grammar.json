{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "quake_config",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "terminator"
        },
        {
          "type": "SYMBOL",
          "name": "declaration"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "command": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "terminator"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "instruction"
          }
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "double_quote"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "terminator"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "instruction"
                  }
                ]
              }
            },
            {
              "type": "SYMBOL",
              "name": "double_quote"
            }
          ]
        }
      ]
    },
    "expression": {
      "type": "PATTERN",
      "value": "[xyz]+",
      "flags": "i"
    },
    "declaration": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "alias_declaration"
        }
      ]
    },
    "alias_declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "function",
          "content": {
            "type": "SYMBOL",
            "name": "alias_function"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "alias_name"
          }
        },
        {
          "type": "FIELD",
          "name": "command",
          "content": {
            "type": "SYMBOL",
            "name": "command"
          }
        }
      ]
    },
    "alias_function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "alias"
        },
        {
          "type": "STRING",
          "value": "temp_alias"
        }
      ]
    },
    "alias_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "double_quote"
            },
            {
              "type": "PATTERN",
              "value": "[^\"]+"
            },
            {
              "type": "SYMBOL",
              "name": "double_quote"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "[^\" \\n]+"
        }
      ]
    },
    "nested_alias_declaration": {
      "type": "SEQ",
      "members": []
    },
    "nested_alias": {
      "type": "ALIAS",
      "content": {
        "type": "SYMBOL",
        "name": "alias_declaration"
      },
      "named": false,
      "value": "nested_alias"
    },
    "terminator": {
      "type": "STRING",
      "value": ";"
    },
    "instruction": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[a-z0-9!_'{}]+",
          "flags": "i"
        }
      ]
    },
    "number": {
      "type": "PATTERN",
      "value": "-?\\d+(\\.\\d+)?"
    },
    "double_quote": {
      "type": "STRING",
      "value": "\""
    },
    "single_quote": {
      "type": "STRING",
      "value": "'"
    },
    "single_quoted_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "single_quote"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "PATTERN",
            "value": "[^']+"
          }
        },
        {
          "type": "SYMBOL",
          "name": "single_quote"
        }
      ]
    },
    "double_quoted_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "double_quote"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^\"'\\n]+"
              },
              {
                "type": "SYMBOL",
                "name": "single_quoted_string"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "double_quote"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}