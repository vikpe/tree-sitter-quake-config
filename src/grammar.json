{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "quake_config",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "terminator"
        },
        {
          "type": "SYMBOL",
          "name": "alias_declaration"
        },
        {
          "type": "SYMBOL",
          "name": "bind_declaration"
        },
        {
          "type": "SYMBOL",
          "name": "function_call"
        },
        {
          "type": "SYMBOL",
          "name": "if_statement"
        }
      ]
    },
    "_statement_sub": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "terminator"
        },
        {
          "type": "SYMBOL",
          "name": "alias_declaration_sub"
        },
        {
          "type": "SYMBOL",
          "name": "bind_declaration_sub"
        },
        {
          "type": "SYMBOL",
          "name": "function_call_sub"
        },
        {
          "type": "SYMBOL",
          "name": "if_statement"
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_whitespace": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "_double_quote": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "\""
      }
    },
    "_single_quote": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "'"
      }
    },
    "alias_function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "alias"
        },
        {
          "type": "STRING",
          "value": "temp_alias"
        }
      ]
    },
    "alias_name": {
      "type": "PATTERN",
      "value": "[^\"\\s]+"
    },
    "alias_declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "function",
          "content": {
            "type": "SYMBOL",
            "name": "alias_function"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_double_quote"
                },
                {
                  "type": "FIELD",
                  "name": "name",
                  "content": {
                    "type": "SYMBOL",
                    "name": "alias_name"
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "_double_quote"
                }
              ]
            },
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "SYMBOL",
                "name": "alias_name"
              }
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "body",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_statement"
              },
              {
                "type": "SYMBOL",
                "name": "expression"
              }
            ]
          }
        }
      ]
    },
    "alias_declaration_sub": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "function",
          "content": {
            "type": "SYMBOL",
            "name": "alias_function"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "alias_name"
          }
        },
        {
          "type": "FIELD",
          "name": "body",
          "content": {
            "type": "SYMBOL",
            "name": "_statement_sub"
          }
        }
      ]
    },
    "bind_function": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "bind"
      }
    },
    "bind_key": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "keyname"
        },
        {
          "type": "SYMBOL",
          "name": "keyname_fallback"
        }
      ]
    },
    "bind_declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "function",
          "content": {
            "type": "SYMBOL",
            "name": "bind_function"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "key",
              "content": {
                "type": "SYMBOL",
                "name": "bind_key"
              }
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_double_quote"
                },
                {
                  "type": "FIELD",
                  "name": "key",
                  "content": {
                    "type": "SYMBOL",
                    "name": "bind_key"
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "_double_quote"
                }
              ]
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "expression",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_statement"
              },
              {
                "type": "SYMBOL",
                "name": "expression"
              }
            ]
          }
        }
      ]
    },
    "bind_declaration_sub": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "function",
          "content": {
            "type": "SYMBOL",
            "name": "bind_function"
          }
        },
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "bind_key"
          }
        },
        {
          "type": "FIELD",
          "name": "expression",
          "content": {
            "type": "SYMBOL",
            "name": "_statement_sub"
          }
        }
      ]
    },
    "expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_double_quote"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_statement_sub"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_double_quote"
        }
      ]
    },
    "function_call": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "name",
            "content": {
              "type": "SYMBOL",
              "name": "function_name"
            }
          },
          {
            "type": "FIELD",
            "name": "args",
            "content": {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "function_arg"
              }
            }
          }
        ]
      }
    },
    "function_arg": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "user_variable_ref"
        },
        {
          "type": "SYMBOL",
          "name": "function_call"
        }
      ]
    },
    "function_call_sub": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "function_name"
          }
        },
        {
          "type": "FIELD",
          "name": "args",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "function_arg_sub"
            }
          }
        }
      ]
    },
    "function_arg_sub": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "user_variable_ref"
        },
        {
          "type": "PATTERN",
          "value": "[a-z]+",
          "flags": "i"
        }
      ]
    },
    "terminator": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": ";"
      }
    },
    "alpha_num": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-z0-9_.]",
        "flags": "i"
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "-?\\d+(\\.\\d+)?"
      }
    },
    "variable_ref": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "function_param_ref"
        },
        {
          "type": "SYMBOL",
          "name": "user_variable_ref"
        },
        {
          "type": "SYMBOL",
          "name": "qizmo_macro_ref"
        },
        {
          "type": "SYMBOL",
          "name": "ezquake_macro_ref"
        }
      ]
    },
    "function_param_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%[0-9]"
      }
    },
    "user_variable_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\$[a-z0-9_]+",
        "flags": "i"
      }
    },
    "qizmo_macro_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%[abc]",
        "flags": "i"
      }
    },
    "ezquake_macro_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "ammo"
            },
            {
              "type": "STRING",
              "value": "armor"
            },
            {
              "type": "STRING",
              "value": "armortype"
            },
            {
              "type": "STRING",
              "value": "bestammo"
            },
            {
              "type": "STRING",
              "value": "bestweapon"
            },
            {
              "type": "STRING",
              "value": "health"
            }
          ]
        }
      ]
    },
    "single_quoted_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_single_quote"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "variable_ref"
              },
              {
                "type": "SYMBOL",
                "name": "number"
              },
              {
                "type": "SYMBOL",
                "name": "alpha_num"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_single_quote"
        }
      ]
    },
    "if_statement": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "if_keyword"
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "("
              },
              {
                "type": "SYMBOL",
                "name": "binary_expression"
              },
              {
                "type": "STRING",
                "value": ")"
              }
            ]
          },
          {
            "type": "SYMBOL",
            "name": "then_keyword"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_statement_sub"
                }
              ]
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "else_keyword"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "if_fallback": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^; ]+"
      }
    },
    "if_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "if"
      }
    },
    "then_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "then"
      }
    },
    "else_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "else"
      }
    },
    "binary_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "value_expression"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "value_expression"
        }
      ]
    },
    "value_expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "single_quoted_string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "variable_ref"
        }
      ]
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "+"
          },
          {
            "type": "STRING",
            "value": "-"
          },
          {
            "type": "STRING",
            "value": "/"
          },
          {
            "type": "STRING",
            "value": "*"
          },
          {
            "type": "STRING",
            "value": ">"
          },
          {
            "type": "STRING",
            "value": "<"
          },
          {
            "type": "STRING",
            "value": "|"
          },
          {
            "type": "STRING",
            "value": "=="
          },
          {
            "type": "STRING",
            "value": "="
          },
          {
            "type": "STRING",
            "value": "!="
          },
          {
            "type": "STRING",
            "value": "!"
          },
          {
            "type": "STRING",
            "value": "=~"
          },
          {
            "type": "STRING",
            "value": "!~"
          },
          {
            "type": "PATTERN",
            "value": " or | and | !isin | isin ",
            "flags": "i"
          }
        ]
      }
    },
    "keyname": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "mouse[1-8]",
            "flags": "i"
          },
          {
            "type": "PATTERN",
            "value": "[\\da-z]",
            "flags": "i"
          },
          {
            "type": "PATTERN",
            "value": "f[1-9]",
            "flags": "i"
          },
          {
            "type": "PATTERN",
            "value": "f1[0-5]",
            "flags": "i"
          },
          {
            "type": "PATTERN",
            "value": "space",
            "flags": "i"
          }
        ]
      }
    },
    "keyname_fallback": {
      "type": "PATTERN",
      "value": "[^\\s\"]+"
    },
    "function_name": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "echo"
          },
          {
            "type": "STRING",
            "value": "connect"
          },
          {
            "type": "STRING",
            "value": "disconnect"
          },
          {
            "type": "STRING",
            "value": "volume"
          },
          {
            "type": "STRING",
            "value": "place"
          },
          {
            "type": "STRING",
            "value": "reconnect"
          },
          {
            "type": "STRING",
            "value": "say"
          },
          {
            "type": "STRING",
            "value": "unbindall"
          },
          {
            "type": "STRING",
            "value": "wait"
          },
          {
            "type": "STRING",
            "value": "quit"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}