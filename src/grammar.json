{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "quake_config",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "terminator"
        },
        {
          "type": "SYMBOL",
          "name": "alias_declaration"
        }
      ]
    },
    "alias_declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "function",
          "content": {
            "type": "SYMBOL",
            "name": "alias_function"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "alias_name"
          }
        },
        {
          "type": "FIELD",
          "name": "body",
          "content": {
            "type": "SYMBOL",
            "name": "alias_body"
          }
        }
      ]
    },
    "alias_function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "alias"
        },
        {
          "type": "STRING",
          "value": "temp_alias"
        }
      ]
    },
    "alias_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "double_quote"
            },
            {
              "type": "PATTERN",
              "value": "[^\"]+"
            },
            {
              "type": "SYMBOL",
              "name": "double_quote"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "[^\" \\n]+"
        }
      ]
    },
    "alias_body": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "single_quoted_string"
        },
        {
          "type": "SYMBOL",
          "name": "double_quoted_string"
        }
      ]
    },
    "terminator": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": ";"
      }
    },
    "alpha_num": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-z0-9_.]",
        "flags": "i"
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "-?\\d+(\\.\\d+)?"
      }
    },
    "double_quote": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "\""
      }
    },
    "single_quote": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "'"
      }
    },
    "variable_ref": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "function_param_ref"
        },
        {
          "type": "SYMBOL",
          "name": "user_variable_ref"
        },
        {
          "type": "SYMBOL",
          "name": "qizmo_macro_ref"
        },
        {
          "type": "SYMBOL",
          "name": "ezquake_macro_ref"
        }
      ]
    },
    "function_param_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%[0-9]"
      }
    },
    "user_variable_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\$[a-z0-9_]+",
        "flags": "i"
      }
    },
    "qizmo_macro_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%[abc]",
        "flags": "i"
      }
    },
    "ezquake_macro_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "ammo"
            },
            {
              "type": "STRING",
              "value": "armor"
            },
            {
              "type": "STRING",
              "value": "armortype"
            },
            {
              "type": "STRING",
              "value": "bestammo"
            },
            {
              "type": "STRING",
              "value": "bestweapon"
            },
            {
              "type": "STRING",
              "value": "health"
            }
          ]
        }
      ]
    },
    "single_quoted_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "single_quote"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "variable_ref"
              },
              {
                "type": "SYMBOL",
                "name": "number"
              },
              {
                "type": "SYMBOL",
                "name": "alpha_num"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "single_quote"
        }
      ]
    },
    "double_quoted_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "double_quote"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "if_statement"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "single_quoted_string"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "variable_ref"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "number"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "alpha_num"
                  }
                ]
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "terminator"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "double_quote"
        }
      ]
    },
    "if_statement": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "if_keyword"
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "("
              },
              {
                "type": "SYMBOL",
                "name": "binary_expression"
              },
              {
                "type": "STRING",
                "value": ")"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "then_keyword"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "alpha_num"
                },
                {
                  "type": "SYMBOL",
                  "name": "variable_ref"
                },
                {
                  "type": "SYMBOL",
                  "name": "alpha_num"
                }
              ]
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "else_keyword"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "if_keyword": {
      "type": "STRING",
      "value": "if"
    },
    "then_keyword": {
      "type": "STRING",
      "value": "then"
    },
    "else_keyword": {
      "type": "STRING",
      "value": "else"
    },
    "binary_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "value_expression"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "value_expression"
        }
      ]
    },
    "value_expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "single_quoted_string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "variable_ref"
        }
      ]
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "+"
          },
          {
            "type": "STRING",
            "value": "-"
          },
          {
            "type": "STRING",
            "value": "/"
          },
          {
            "type": "STRING",
            "value": "*"
          },
          {
            "type": "STRING",
            "value": ">"
          },
          {
            "type": "STRING",
            "value": "<"
          },
          {
            "type": "STRING",
            "value": "|"
          },
          {
            "type": "STRING",
            "value": "="
          },
          {
            "type": "STRING",
            "value": "=="
          },
          {
            "type": "STRING",
            "value": "!="
          },
          {
            "type": "STRING",
            "value": "!"
          },
          {
            "type": "PATTERN",
            "value": " or | and | isin | !isin ",
            "flags": "i"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}