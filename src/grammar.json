{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "quake_config",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "command"
        },
        {
          "type": "SYMBOL",
          "name": "setting"
        },
        {
          "type": "SYMBOL",
          "name": "set"
        },
        {
          "type": "SYMBOL",
          "name": "alias"
        },
        {
          "type": "SYMBOL",
          "name": "bind"
        }
      ]
    },
    "command": {
      "type": "SYMBOL",
      "name": "command_name"
    },
    "set": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "set_function"
        },
        {
          "type": "SYMBOL",
          "name": "set_key"
        },
        {
          "type": "SYMBOL",
          "name": "set_value"
        }
      ]
    },
    "set_function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "set"
        },
        {
          "type": "STRING",
          "value": "set_tp"
        }
      ]
    },
    "set_key": {
      "type": "SYMBOL",
      "name": "label"
    },
    "set_value": {
      "type": "SYMBOL",
      "name": "value"
    },
    "setting": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "setting_name"
        },
        {
          "type": "SYMBOL",
          "name": "setting_value"
        }
      ]
    },
    "setting_name": {
      "type": "SYMBOL",
      "name": "command_name"
    },
    "setting_value": {
      "type": "SYMBOL",
      "name": "value"
    },
    "alias": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "alias_function"
        },
        {
          "type": "SYMBOL",
          "name": "alias_key"
        },
        {
          "type": "SYMBOL",
          "name": "alias_value"
        }
      ]
    },
    "alias_function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "alias"
        },
        {
          "type": "STRING",
          "value": "tempalias"
        }
      ]
    },
    "alias_key": {
      "type": "SYMBOL",
      "name": "label"
    },
    "alias_value": {
      "type": "SYMBOL",
      "name": "value"
    },
    "bind": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "bind_function"
        },
        {
          "type": "SYMBOL",
          "name": "bind_key"
        },
        {
          "type": "SYMBOL",
          "name": "bind_value"
        }
      ]
    },
    "bind_function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "bind"
        },
        {
          "type": "STRING",
          "value": "tempbind"
        }
      ]
    },
    "bind_key": {
      "type": "SYMBOL",
      "name": "label"
    },
    "bind_value": {
      "type": "SYMBOL",
      "name": "value"
    },
    "string": {
      "type": "PATTERN",
      "value": "\"[^\"]*\""
    },
    "number": {
      "type": "PATTERN",
      "value": "-?\\d+(\\.\\d+)?"
    },
    "label": {
      "type": "PATTERN",
      "value": "[a-z0-9_]+",
      "flags": "i"
    },
    "variable": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "SYMBOL",
          "name": "label"
        }
      ]
    },
    "command_name": {
      "type": "PATTERN",
      "value": "[a-z][a-z0-9_]*",
      "flags": "i"
    },
    "value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "label"
        },
        {
          "type": "SYMBOL",
          "name": "variable"
        }
      ]
    },
    "quoted_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "SYMBOL",
          "name": "value"
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}