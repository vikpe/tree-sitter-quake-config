{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "quake_config",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "number": {
      "type": "PATTERN",
      "value": "-?\\d+(\\.\\d+)?"
    },
    "double_quote": {
      "type": "STRING",
      "value": "\""
    },
    "single_quote": {
      "type": "STRING",
      "value": "'"
    },
    "empty_string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "\"s*\""
        },
        {
          "type": "STRING",
          "value": "'s*'"
        }
      ]
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "alias"
        },
        {
          "type": "SYMBOL",
          "name": "bind"
        },
        {
          "type": "SYMBOL",
          "name": "set"
        },
        {
          "type": "SYMBOL",
          "name": "fallback"
        }
      ]
    },
    "fallback": {
      "type": "PATTERN",
      "value": "[^\\s]+"
    },
    "alias": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "alias_function"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "SYMBOL",
                "name": "alias_name"
              }
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "single_quote"
                },
                {
                  "type": "FIELD",
                  "name": "name",
                  "content": {
                    "type": "SYMBOL",
                    "name": "alias_name"
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "single_quote"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "double_quote"
                },
                {
                  "type": "FIELD",
                  "name": "name",
                  "content": {
                    "type": "SYMBOL",
                    "name": "alias_name"
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "double_quote"
                }
              ]
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "definition",
          "content": {
            "type": "SYMBOL",
            "name": "expression"
          }
        }
      ]
    },
    "alias_function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "alias"
        },
        {
          "type": "STRING",
          "value": "tempalias"
        }
      ]
    },
    "alias_name": {
      "type": "PATTERN",
      "value": "[^\\s\"']+"
    },
    "bind": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "bind_function"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "key",
              "content": {
                "type": "SYMBOL",
                "name": "bind_key"
              }
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "single_quote"
                },
                {
                  "type": "FIELD",
                  "name": "key",
                  "content": {
                    "type": "SYMBOL",
                    "name": "bind_key"
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "single_quote"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "double_quote"
                },
                {
                  "type": "FIELD",
                  "name": "key",
                  "content": {
                    "type": "SYMBOL",
                    "name": "bind_key"
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "double_quote"
                }
              ]
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "definition",
          "content": {
            "type": "SYMBOL",
            "name": "expression"
          }
        }
      ]
    },
    "bind_function": {
      "type": "STRING",
      "value": "bind"
    },
    "bind_key": {
      "type": "PATTERN",
      "value": "[a-z0-9]+"
    },
    "set": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "set_function"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "SYMBOL",
                "name": "set_name"
              }
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "single_quote"
                },
                {
                  "type": "FIELD",
                  "name": "name",
                  "content": {
                    "type": "SYMBOL",
                    "name": "set_name"
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "single_quote"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "double_quote"
                },
                {
                  "type": "FIELD",
                  "name": "name",
                  "content": {
                    "type": "SYMBOL",
                    "name": "set_name"
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "double_quote"
                }
              ]
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "definition",
          "content": {
            "type": "SYMBOL",
            "name": "value_expression"
          }
        }
      ]
    },
    "set_function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "set"
        },
        {
          "type": "STRING",
          "value": "set_tp"
        }
      ]
    },
    "set_name": {
      "type": "PATTERN",
      "value": "[^\\s\"']+"
    },
    "value_expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "empty_string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "variable_ref"
        },
        {
          "type": "SYMBOL",
          "name": "macro_ref"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "single_quote"
            },
            {
              "type": "SYMBOL",
              "name": "value_string"
            },
            {
              "type": "SYMBOL",
              "name": "single_quote"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "double_quote"
            },
            {
              "type": "SYMBOL",
              "name": "value_string"
            },
            {
              "type": "SYMBOL",
              "name": "double_quote"
            }
          ]
        }
      ]
    },
    "value_string": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "number"
          },
          {
            "type": "SYMBOL",
            "name": "variable_ref"
          },
          {
            "type": "SYMBOL",
            "name": "macro_ref"
          },
          {
            "type": "SYMBOL",
            "name": "color_def"
          },
          {
            "type": "SYMBOL",
            "name": "punctuation"
          }
        ]
      }
    },
    "expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "empty_string"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "single_quote"
            },
            {
              "type": "REPEAT1",
              "content": {
                "type": "SYMBOL",
                "name": "expression_content"
              }
            },
            {
              "type": "SYMBOL",
              "name": "single_quote"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "double_quote"
            },
            {
              "type": "REPEAT1",
              "content": {
                "type": "SYMBOL",
                "name": "expression_content"
              }
            },
            {
              "type": "SYMBOL",
              "name": "double_quote"
            }
          ]
        }
      ]
    },
    "expression_content": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "conditional_expression"
        },
        {
          "type": "SYMBOL",
          "name": "simple_expression"
        }
      ]
    },
    "simple_expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "variable_ref"
        },
        {
          "type": "SYMBOL",
          "name": "macro_ref"
        },
        {
          "type": "SYMBOL",
          "name": "punctuation"
        }
      ]
    },
    "conditional_expression": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "if_key"
          },
          {
            "type": "SYMBOL",
            "name": "condition"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "then_key"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "SYMBOL",
            "name": "simple_expression"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "else_key"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "if_key": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "if",
        "flags": "i"
      }
    },
    "then_key": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "then",
        "flags": "i"
      }
    },
    "else_key": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "else",
        "flags": "i"
      }
    },
    "condition": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "parenthesized_condition"
        },
        {
          "type": "SYMBOL",
          "name": "binary_expression"
        },
        {
          "type": "SYMBOL",
          "name": "value_expression"
        }
      ]
    },
    "binary_expression": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "value_expression"
          },
          {
            "type": "SYMBOL",
            "name": "operator"
          },
          {
            "type": "SYMBOL",
            "name": "value_expression"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "operator"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "parenthesized_condition": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "condition"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "conditional": {
      "type": "PATTERN",
      "value": "if|if_exists|then|else",
      "flags": "i"
    },
    "operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "STRING",
          "value": "/"
        },
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "STRING",
          "value": ">"
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "STRING",
          "value": "=="
        },
        {
          "type": "STRING",
          "value": "!="
        },
        {
          "type": "STRING",
          "value": "!"
        },
        {
          "type": "PATTERN",
          "value": "or|and|isin",
          "flags": "i"
        }
      ]
    },
    "punctuation": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "color_def": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "&c"
        },
        {
          "type": "PATTERN",
          "value": "[0-9a-f]{3}",
          "flags": "i"
        }
      ]
    },
    "variable_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "PATTERN",
          "value": "[a-z0-9.:_-]+",
          "flags": "i"
        }
      ]
    },
    "macro_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "PATTERN",
          "value": "[a-z0-9]+",
          "flags": "i"
        }
      ]
    },
    "stringlike": {
      "type": "PATTERN",
      "value": "[^\\s]+"
    },
    "function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "+fire"
        },
        {
          "type": "STRING",
          "value": "weapon"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}