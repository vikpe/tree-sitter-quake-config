{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "quake_config",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_statement"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "newline"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "bind"
            },
            {
              "type": "SYMBOL",
              "name": "command"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "newline"
            },
            {
              "type": "SYMBOL",
              "name": "terminator"
            }
          ]
        }
      ]
    },
    "command": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "unquoted_string"
          }
        },
        {
          "type": "FIELD",
          "name": "args",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "command_argument"
            }
          }
        }
      ]
    },
    "bind": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "function"
        },
        {
          "type": "SYMBOL",
          "name": "bind_expr"
        },
        {
          "type": "SYMBOL",
          "name": "command_argument"
        }
      ]
    },
    "bind_expr": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "single_quote"
            },
            {
              "type": "SYMBOL",
              "name": "bind_key"
            },
            {
              "type": "SYMBOL",
              "name": "single_quote"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "double_quote"
            },
            {
              "type": "SYMBOL",
              "name": "bind_key"
            },
            {
              "type": "SYMBOL",
              "name": "double_quote"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "bind_key"
        }
      ]
    },
    "bind_key": {
      "type": "PATTERN",
      "value": "[a-z0-9][a-z0-9_]*",
      "flags": "i"
    },
    "terminator": {
      "type": "STRING",
      "value": ";"
    },
    "double_quote": {
      "type": "STRING",
      "value": "\""
    },
    "single_quote": {
      "type": "STRING",
      "value": "'"
    },
    "quote": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "single_quote"
        },
        {
          "type": "SYMBOL",
          "name": "double_quote"
        }
      ]
    },
    "string": {
      "type": "PATTERN",
      "value": "\"[^\"]*\""
    },
    "unquoted_string": {
      "type": "PATTERN",
      "value": "[^\\s^;\"]+"
    },
    "conditional": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "if"
        },
        {
          "type": "STRING",
          "value": "then"
        },
        {
          "type": "STRING",
          "value": "else"
        },
        {
          "type": "STRING",
          "value": "isin"
        }
      ]
    },
    "command_prefix": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "STRING",
          "value": "/"
        }
      ]
    },
    "operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "STRING",
          "value": "/"
        },
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "STRING",
          "value": ">"
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "STRING",
          "value": "="
        }
      ]
    },
    "bracket": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "number": {
      "type": "PATTERN",
      "value": "-?\\d+(\\.\\d+)?"
    },
    "variable_name": {
      "type": "PATTERN",
      "value": "[a-z0-9.:_-]+",
      "flags": "i"
    },
    "command_argument": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "function"
        },
        {
          "type": "SYMBOL",
          "name": "value"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "double_quote"
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "expression_content"
                },
                {
                  "type": "SYMBOL",
                  "name": "single_quoted_string"
                }
              ]
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "double_quote"
        }
      ]
    },
    "expression_content": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "conditional"
        },
        {
          "type": "SYMBOL",
          "name": "terminator"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "value"
        },
        {
          "type": "SYMBOL",
          "name": "bracket"
        },
        {
          "type": "SYMBOL",
          "name": "function"
        }
      ]
    },
    "single_quoted_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "single_quote"
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "expression_content"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "single_quote"
        }
      ]
    },
    "ref": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "variable_ref"
        },
        {
          "type": "SYMBOL",
          "name": "macro_ref"
        }
      ]
    },
    "variable_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "SYMBOL",
          "name": "variable_name"
        }
      ]
    },
    "macro_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "PATTERN",
          "value": "[a-z0-9]+",
          "flags": "i"
        }
      ]
    },
    "value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "ref"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "variable_name"
        }
      ]
    },
    "function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "bind"
        },
        {
          "type": "STRING",
          "value": "quit"
        },
        {
          "type": "STRING",
          "value": "wait"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}