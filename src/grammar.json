{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "quake_config",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "terminator"
        },
        {
          "type": "SYMBOL",
          "name": "alias_declaration"
        }
      ]
    },
    "alias_declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "function",
          "content": {
            "type": "SYMBOL",
            "name": "alias_function"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "alias_name"
          }
        },
        {
          "type": "FIELD",
          "name": "body",
          "content": {
            "type": "SYMBOL",
            "name": "alias_body"
          }
        }
      ]
    },
    "alias_function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "alias"
        },
        {
          "type": "STRING",
          "value": "temp_alias"
        }
      ]
    },
    "alias_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "double_quote"
            },
            {
              "type": "PATTERN",
              "value": "[^\"]+"
            },
            {
              "type": "SYMBOL",
              "name": "double_quote"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "[^\" \\n]+"
        }
      ]
    },
    "alias_body": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "single_quoted_string"
        },
        {
          "type": "SYMBOL",
          "name": "double_quoted_string"
        }
      ]
    },
    "terminator": {
      "type": "STRING",
      "value": ";"
    },
    "number": {
      "type": "PATTERN",
      "value": "-?\\d+(\\.\\d+)?"
    },
    "double_quote": {
      "type": "STRING",
      "value": "\""
    },
    "single_quote": {
      "type": "STRING",
      "value": "'"
    },
    "variable_ref": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "function_param_ref"
        },
        {
          "type": "SYMBOL",
          "name": "user_variable_ref"
        },
        {
          "type": "SYMBOL",
          "name": "qizmo_macro_ref"
        },
        {
          "type": "SYMBOL",
          "name": "ezquake_macro_ref"
        }
      ]
    },
    "function_param_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "PATTERN",
          "value": "[0-9]"
        }
      ]
    },
    "user_variable_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "PATTERN",
          "value": "[a-z0-9_]+",
          "flags": "i"
        }
      ]
    },
    "qizmo_macro_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "a"
            },
            {
              "type": "STRING",
              "value": "b"
            },
            {
              "type": "STRING",
              "value": "c"
            },
            {
              "type": "STRING",
              "value": "A"
            },
            {
              "type": "STRING",
              "value": "B"
            },
            {
              "type": "STRING",
              "value": "C"
            }
          ]
        }
      ]
    },
    "ezquake_macro_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "ammo"
            },
            {
              "type": "STRING",
              "value": "armor"
            },
            {
              "type": "STRING",
              "value": "armortype"
            },
            {
              "type": "STRING",
              "value": "bestammo"
            },
            {
              "type": "STRING",
              "value": "bestweapon"
            },
            {
              "type": "STRING",
              "value": "health"
            }
          ]
        }
      ]
    },
    "label_like": {
      "type": "PATTERN",
      "value": "[a-z0-9_().><]+",
      "flags": "i"
    },
    "single_quoted_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "single_quote"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "variable_ref"
              },
              {
                "type": "SYMBOL",
                "name": "number"
              },
              {
                "type": "SYMBOL",
                "name": "label_like"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "single_quote"
        }
      ]
    },
    "double_quoted_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "double_quote"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "if_statement"
              },
              {
                "type": "SYMBOL",
                "name": "single_quoted_string"
              },
              {
                "type": "SYMBOL",
                "name": "variable_ref"
              },
              {
                "type": "SYMBOL",
                "name": "number"
              },
              {
                "type": "SYMBOL",
                "name": "terminator"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "double_quote"
        }
      ]
    },
    "else_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "else"
        },
        {
          "type": "SYMBOL",
          "name": "if_statement"
        }
      ]
    },
    "if_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "if",
          "flags": "i"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "binary_expression"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "then"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "label_like"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "else_clause"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "binary_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "value_expression"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "value_expression"
        }
      ]
    },
    "value_expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "single_quoted_string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "variable_ref"
        }
      ]
    },
    "operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "STRING",
          "value": "/"
        },
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "STRING",
          "value": ">"
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "STRING",
          "value": "=="
        },
        {
          "type": "STRING",
          "value": "!="
        },
        {
          "type": "STRING",
          "value": "!"
        },
        {
          "type": "PATTERN",
          "value": "or|and|isin",
          "flags": "i"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}