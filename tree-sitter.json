{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "quake_config",
      "camelcase": "QuakeConfig",
      "title": "Quake Config",
      "scope": "source.quake_config",
      "file-types": ["cfg"],
      "injection-regex": "^quake_config$",
      "class-name": "TreeSitterQuakeConfig",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "tree-sitter grammar for Quake config files",
    "authors": [
      {
        "name": "Viktor Persson",
        "email": "viktor.persson@arcsin.se",
        "url": "https://vikpe.org"
      }
    ],
    "links": {
      "repository": "https://github.com/vikpe/tree-sitter-quake-config",
      "funding": "https://github.com/vikpe/tree-sitter-quake-config"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
